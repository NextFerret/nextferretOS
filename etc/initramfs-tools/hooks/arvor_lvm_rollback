#!/bin/sh
# /etc/initramfs-tools/hooks/arvor_lvm_rollback
# Ensures LVM2 binaries, thin provisioning tools, and utilities are available in the initramfs.

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Copy required LVM2 tools
copy_exec /sbin/lvm /sbin
copy_exec /sbin/lvcreate /sbin
copy_exec /sbin/lvrename /sbin
copy_exec /sbin/lvremove /sbin
copy_exec /sbin/lvconvert /sbin
copy_exec /sbin/lvchange /sbin
copy_exec /sbin/lvs /sbin
copy_exec /sbin/vgs /sbin

# Copy thin provisioning tools if present
if [ -x /usr/sbin/thin_check ]; then
    copy_exec /usr/sbin/thin_check /usr/sbin
fi
if [ -x /usr/sbin/thin_dump ]; then
    copy_exec /usr/sbin/thin_dump /usr/sbin
fi
if [ -x /usr/sbin/thin_repair ]; then
    copy_exec /usr/sbin/thin_repair /usr/sbin
fi

# Copy filesystem detection and string helpers
copy_exec /usr/bin/findmnt /usr/bin || true
copy_exec /bin/sed /bin || true
copy_exec /usr/bin/cut /usr/bin || true

exit 0
