#!/bin/sh
# /etc/initramfs-tools/scripts/local-top/arvor_lvm_snapshot
# Thin LVM A/B/C automated snapshot rotation and boot-failure rollback

PREREQ="lvm2"

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /scripts/functions

log_info() {
    echo "[Arvor Initramfs] $1"
}

log_warn() {
    echo "\033[1;33m[Arvor Initramfs WARNING] $1\033[0m"
}

log_alert() {
    echo "\033[1;31m[Arvor Initramfs ALERT] $1\033[0m"
}

show_plymouth_msg() {
    if command -v plymouth >/dev/null 2>&1 && plymouth --ping 2>/dev/null; then
        plymouth display-message --text="$1" 2>/dev/null || true
    fi
}

# 1. Activate LVM volumes
if [ -x /sbin/lvm ]; then
    /sbin/lvm vgchange -ay --ignoreactivationskip >/dev/null 2>&1
    udevadm settle >/dev/null 2>&1 || true
fi

# 2. Identify Root Device / Volume Group / Logical Volume
ROOT_DEV=""
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=*)
            ROOT_DEV="${arg#root=}"
            ;;
    esac
done

# If ROOT_DEV is UUID or PARTUUID, resolve device node
if echo "$ROOT_DEV" | grep -q "^UUID="; then
    UUID_VAL="${ROOT_DEV#UUID=}"
    ROOT_DEV=$(blkid -U "$UUID_VAL" 2>/dev/null || findfs "UUID=$UUID_VAL" 2>/dev/null || echo "")
elif echo "$ROOT_DEV" | grep -q "^PARTUUID="; then
    PART_VAL="${ROOT_DEV#PARTUUID=}"
    ROOT_DEV=$(blkid -t "PARTUUID=$PART_VAL" -o device 2>/dev/null || findfs "PARTUUID=$PART_VAL" 2>/dev/null || echo "")
fi

# Fallback auto-detection of root LV
if [ -z "$ROOT_DEV" ] || ! /sbin/lvm lvs "$ROOT_DEV" >/dev/null 2>&1; then
    # Try finding an LV named 'root'
    ROOT_DEV=$(/sbin/lvm lvs --noheadings -o vg_name,lv_name 2>/dev/null | awk '{if ($2 == "root") print "/dev/"$1"/"$2; else if ($2 ~ /^root/) print "/dev/"$1"/"$2;}' | head -n 1)
fi

if [ -z "$ROOT_DEV" ] || ! /sbin/lvm lvs "$ROOT_DEV" >/dev/null 2>&1; then
    log_warn "Could not identify root LVM volume ($ROOT_DEV). Skipping A/B/C snapshot hook."
    exit 0
fi

VG_NAME=$(/sbin/lvm lvs --noheadings -o vg_name "$ROOT_DEV" 2>/dev/null | tr -d ' ')
LV_NAME=$(/sbin/lvm lvs --noheadings -o lv_name "$ROOT_DEV" 2>/dev/null | tr -d ' ')

if [ -z "$VG_NAME" ] || [ -z "$LV_NAME" ]; then
    log_warn "Failed to parse VG or LV for $ROOT_DEV. Skipping."
    exit 0
fi

# 3. Check if previous boot succeeded
# We check LVM tag 'boot_ok' on the root volume
LV_TAGS=$(/sbin/lvm lvs --noheadings -o lv_tags "$ROOT_DEV" 2>/dev/null | tr -d ' ')
PREV_BOOT_OK=false

if echo "$LV_TAGS" | grep -q "boot_ok"; then
    PREV_BOOT_OK=true
fi

# 4. Perform A/B/C Thin LVM Snapshot Rotation or Rollback
if [ "$PREV_BOOT_OK" = "true" ]; then
    log_info "Previous boot was marked SUCCESSFUL. Starting A/B/C snapshot rotation..."

    # Reset boot_ok tag so the current boot must validate itself via systemd
    /sbin/lvm lvchange --deltag boot_ok "$ROOT_DEV" >/dev/null 2>&1 || true

    # Step A: Delete root_c if it exists
    if /sbin/lvm lvs "/dev/$VG_NAME/root_c" >/dev/null 2>&1; then
        log_info "Purging oldest snapshot root_c..."
        /sbin/lvm lvremove -f "/dev/$VG_NAME/root_c" >/dev/null 2>&1 || true
    fi

    # Step B: Promote root_b to root_c if root_b exists
    if /sbin/lvm lvs "/dev/$VG_NAME/root_b" >/dev/null 2>&1; then
        log_info "Promoting root_b -> root_c..."
        /sbin/lvm lvrename "$VG_NAME" root_b root_c >/dev/null 2>&1 || true
    fi

    # Step C: Create fresh thin snapshot root_b of current root
    log_info "Creating new snapshot root_b from /dev/$VG_NAME/$LV_NAME..."
    if /sbin/lvm lvcreate -s --name root_b -k n "/dev/$VG_NAME/$LV_NAME" >/dev/null 2>&1; then
        log_info "Snapshot root_b successfully established."
    else
        log_warn "Failed to create root_b thin snapshot."
    fi

else
    log_alert "Previous boot was NOT marked as OK (Crash or dirty shutdown detected)!"

    # Attempt Rollback to root_b first
    if /sbin/lvm lvs "/dev/$VG_NAME/root_b" >/dev/null 2>&1; then
        log_alert "Rolling back root partition to snapshot root_b..."
        show_plymouth_msg "Arvor Linux: Boot failure detected. Reverting root partition to snapshot root_b..."
        if /sbin/lvm lvconvert --merge "/dev/$VG_NAME/root_b" >/dev/null 2>&1; then
            log_alert "Rollback to root_b successful!"
            # Promote root_c -> root_b as fallback for next round
            if /sbin/lvm lvs "/dev/$VG_NAME/root_c" >/dev/null 2>&1; then
                /sbin/lvm lvrename "$VG_NAME" root_c root_b >/dev/null 2>&1 || true
            fi
        else
            log_alert "Merging root_b failed! Trying fallback to root_c..."
            if /sbin/lvm lvs "/dev/$VG_NAME/root_c" >/dev/null 2>&1; then
                show_plymouth_msg "Arvor Linux: Fallback rollback to snapshot root_c..."
                /sbin/lvm lvconvert --merge "/dev/$VG_NAME/root_c" >/dev/null 2>&1 || true
            fi
        fi
    elif /sbin/lvm lvs "/dev/$VG_NAME/root_c" >/dev/null 2>&1; then
        log_alert "root_b missing. Rolling back directly to snapshot root_c..."
        show_plymouth_msg "Arvor Linux: Reverting root partition to snapshot root_c..."
        /sbin/lvm lvconvert --merge "/dev/$VG_NAME/root_c" >/dev/null 2>&1 || true
    else
        log_warn "No previous snapshot (root_b or root_c) found to roll back to. Continuing standard boot."
    fi
fi

# Ensure all LVM changes are synced and devices ready for mounting
/sbin/lvm vgchange -ay --ignoreactivationskip >/dev/null 2>&1
udevadm settle >/dev/null 2>&1 || true

exit 0
