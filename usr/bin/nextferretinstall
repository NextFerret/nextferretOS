    def validate_user_fields(self):
        user = self.i_user.text().strip()
        import re
        if user and not re.match(r'^[a-z_][a-z0-9_-]*$', user):
            self.lbl_user_err.setText(self.t("err_user_format"))
            self.lbl_user_err.show()
        else:
            self.lbl_user_err.hide()

    def update_password_strength(self, pwd):
        if not pwd:
            self.pass_strength_bar.setValue(0)
            self.pass_strength_bar.hide()
            self.lbl_strength.setText("")
            self.lbl_strength.hide()
            return

        self.pass_strength_bar.show()
        self.lbl_strength.show()
        score = 0
        if len(pwd) >= 6: score += 20
        if len(pwd) >= 10: score += 20
        if any(c.islower() for c in pwd): score += 20
        if any(c.isupper() for c in pwd): score += 20
        if any(c.isdigit() for c in pwd) or any(not c.isalnum() for c in pwd): score += 20

        self.pass_strength_bar.setValue(score)
        if score < 40:
            self.pass_strength_bar.setStyleSheet("QProgressBar::chunk{background:#ef4444;border-radius:3px;}")
            self.lbl_strength.setText(f"{self.t('lbl_pass_strength')}: <span style='color:#ef4444;font-weight:bold;'>{self.t('weak')}</span>")
        elif score < 80:
            self.pass_strength_bar.setStyleSheet("QProgressBar::chunk{background:#f59e0b;border-radius:3px;}")
            self.lbl_strength.setText(f"{self.t('lbl_pass_strength')}: <span style='color:#f59e0b;font-weight:bold;'>{self.t('medium')}</span>")
        else:
            self.pass_strength_bar.setStyleSheet("QProgressBar::chunk{background:#10b981;border-radius:3px;}")
            self.lbl_strength.setText(f"{self.t('lbl_pass_strength')}: <span style='color:#10b981;font-weight:bold;'>{self.t('strong')}</span>")

    def create_summary_page(self):
        w = QWidget()
        l = QVBoxLayout()
        l.addWidget(self.create_title("step_summary"))

        self.lbl_sum_warn = QLabel(self.t("summary_warn"))
        self.lbl_sum_warn.setStyleSheet("background-color: #fef2f2; color: #991b1b; padding: 20px; border-radius: 12px; font-weight: 600; border: 1px solid #fca5a5; font-size: 15px;")
        self.lbl_sum_warn.setWordWrap(True)

        self.lbl_sum_text = QTextEdit()
        self.lbl_sum_text.setReadOnly(True)
        self.lbl_sum_text.setStyleSheet("border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; background-color: white; font-size: 15px;")

        l.addWidget(self.lbl_sum_warn)
        l.addSpacing(15)
        l.addWidget(self.lbl_sum_text)
        w.setLayout(l)
        return w

    def detect_hardware_info(self):
        cpu = "Processador Otimizado (8 Cores x86_64)"
        ram = "Memoria RAM: ~16 GB"
        gpu = "Placa Grafica: Aceleracao de Hardware Ativa"
        if not SIMULATE:
            try:
                with open("/proc/cpuinfo", "r") as f:
                    for line in f:
                        if "model name" in line:
                            cpu = f"Processador: {line.split(':')[1].strip()}"
                            break
            except Exception: pass
            try:
                with open("/proc/meminfo", "r") as f:
                    for line in f:
                        if "MemTotal" in line:
                            kb = int(line.split()[1])
                            gb = round(kb / (1024 * 1024), 1)
                            ram = f"Memoria RAM: {gb} GB"
                            break
            except Exception: pass
        return f"{cpu}<br>{ram}<br>{gpu}"

    def populate_summary(self):
        disp = self.conf.get('display_name', self.conf['user'])
        user_info = f"{disp} ({self.conf['user']})" if disp != self.conf['user'] else self.conf['user']
        extras = self.conf.get('extra_pkgs', '')
        extra_str = f" + Pacotes Opcionais ({extras})" if extras else ""
        hw_info = self.detect_hardware_info()
        swap_label_key = next((lk for m, lk in self.swap_modes if m == self.conf.get("swap_mode", "zram")), "swap_zram")
        swap_desc = self.t(swap_label_key)
        html = f"""
        <style>
            h3 {{ color: #0f172a; margin-bottom: 8px; font-size: 16px; font-family: -apple-system, sans-serif; font-weight: 700; }}
            p {{ color: #475569; margin-top: 0; margin-bottom: 16px; font-family: -apple-system, sans-serif; font-size: 14px; line-height: 1.4; }}
            hr {{ border: 0; border-top: 1px solid #f1f5f9; margin: 12px 0; }}
        </style>
        <h3>Especificações do Sistema & Hardware</h3><p>{hw_info}</p><hr>
        <h3>{self.t("step_location")}</h3><p>{self.sys_locale} • {self.conf['timezone']}</p><hr>
        <h3>{self.t("step_keyboard")}</h3><p>{self.conf['keymap']}</p><hr>
        <h3>{self.t("step_desktop")}</h3><p>{self.conf['de_name']}{extra_str}</p><hr>
        <h3>{self.t("step_partitions")}</h3><p>{self.conf['disk']} <br>LUKS: {'Activado' if self.conf['luks'] else 'Desactivado'}<br><b>Memória & Swap:</b> {swap_desc}</p><hr>
        <h3>{self.t("step_users")}</h3><p>{user_info} @ {self.conf['hostname']}</p>
        """
        self.lbl_sum_text.setHtml(html)

    def update_slide_ui(self):
        s = self.slides[self.current_slide_idx]
        svg_code = self.slide_svgs[self.current_slide_idx]
        try:
            renderer = QSvgRenderer(QByteArray(svg_code.encode('utf-8')))
            pm = QPixmap(300, 240)
            pm.fill(Qt.GlobalColor.transparent)
            painter = QPainter(pm)
            renderer.render(painter)
            painter.end()
            if not pm.isNull():
                self.lbl_slide_art.setPixmap(pm)
        except Exception:
            pass

        self.lbl_slide_title.setText(self.t(s["title_key"]))
        self.lbl_slide_desc.setText(self.t(s["desc_key"]))
        for i, dot in enumerate(self.slide_dots):
            if i == self.current_slide_idx:
                dot.setStyleSheet("background:#38bdf8; border-radius:4px; min-width:20px; max-width:20px; min-height:8px; max-height:8px;")
            else:
                dot.setStyleSheet("background:rgba(255,255,255,0.25); border-radius:4px; min-width:8px; max-width:8px; min-height:8px; max-height:8px;")

    def next_slide(self):
        self.current_slide_idx = (self.current_slide_idx + 1) % len(self.slides)
        self.update_slide_ui()

    def prev_slide(self):
        self.current_slide_idx = (self.current_slide_idx - 1) % len(self.slides)
        self.update_slide_ui()

