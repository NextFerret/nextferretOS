        self.lbl_luks_p = self._create_label("luks_p", "font-weight: 600; color: #64748b; margin-top: 10px; margin-bottom: 5px;")
        self.luks_p_wrapper, self.i_luks_p = self._make_password_field(enabled=False)
        self.i_luks_p.setPlaceholderText("Senha de encriptação do disco")
        def on_luks_toggle(checked):
            self.luks_p_wrapper.setEnabled(checked)
            self.i_luks_p.setEnabled(checked)
            self.luks_p_wrapper.setStyleSheet(
                "QFrame{background:#fff;border:1px solid #d9e1eb;border-radius:12px;}"
                "QFrame:focus-within{border:1px solid #4a78ff;background:#fbfcff;}" if checked
                else "QFrame{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;}"
            )
        self.chk_luks.toggled.connect(on_luks_toggle)

        cl.addWidget(self.chk_luks)
        cl.addWidget(lbl_luks_hint)
        cl.addWidget(self.lbl_luks_p)
        cl.addWidget(self.luks_p_wrapper)

        l.addWidget(card)
        l.addStretch()
        scroll.setWidget(w)
        return scroll

    def update_swap_options(self):
        if not hasattr(self, 'c_swap'): return
        curr_mode = self.conf.get("swap_mode", "zram")
        self.c_swap.blockSignals(True)
        self.c_swap.clear()
        selected_idx = 0
        for idx, (mode, label_key) in enumerate(self.swap_modes):
            self.c_swap.addItem(self.t(label_key), mode)
            if mode == curr_mode:
                selected_idx = idx
        self.c_swap.setCurrentIndex(selected_idx)
        self.c_swap.blockSignals(False)

    def on_swap_mode_changed(self, idx):
        if hasattr(self, 'c_swap'):
            mode = self.c_swap.currentData()
            if mode:
                self.conf["swap_mode"] = mode

    def update_disk_preview(self):
        idx = self.c_disk.currentIndex()
        if idx >= 0 and idx < len(self.disks_info):
            d = self.disks_info[idx]
            size_str = d.get('size', '')
            name = d.get('name', 'sda')
            model = d.get('model', 'Disk')
            self.lbl_disk_legend.setText(
                f"<b>Dispositivo Selecionado:</b> /dev/{name} ({model} - {size_str}) | <b>Tabela:</b> GPT<br>"
                f"<span style='color:#3b82f6; font-weight:bold;'>[ESP]</span> 512 MiB (FAT32, /boot/efi) &nbsp;&nbsp;&nbsp;&nbsp; "
                f"<span style='color:#6366f1; font-weight:bold;'>[Boot]</span> 1024 MiB (EXT4, /boot)<br>"
                f"<span style='color:#10b981; font-weight:bold;'>[Arvor OS Root]</span> ~78% (XFS Thin Pool) &nbsp;&nbsp;&nbsp;&nbsp; "
                f"<span style='color:#8b5cf6; font-weight:bold;'>[Snapshots NSM]</span> ~22% (VG Free)"
            )

    def slugify_username(self, name):
        import unicodedata, re
        n = unicodedata.normalize('NFKD', name).encode('ASCII', 'ignore').decode('utf-8')
        n = n.lower().strip()
        n = re.sub(r'[\s_]+', '-', n)
        n = re.sub(r'[^a-z0-9-]', '', n)
        n = re.sub(r'^[^a-z]+', '', n)
        return n[:32]

    def on_display_name_changed(self, text):
        if not self.user_manually_edited:
            slugified = self.slugify_username(text)
            self.i_user.setText(slugified)

    def on_username_edited(self, text):
        self.user_manually_edited = True

