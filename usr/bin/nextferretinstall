TRANSLATIONS_FILE = "/etc/nextferretinst/translations.json"

def load_translations():
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        TRANSLATIONS_FILE,
        os.path.normpath(os.path.join(script_dir, "..", "..", "etc", "nextferretinst", "translations.json")),
        os.path.normpath(os.path.join(script_dir, "..", "etc", "nextferretinst", "translations.json")),
        os.path.join(os.getcwd(), "etc", "nextferretinst", "translations.json"),
        os.path.join("etc", "nextferretinst", "translations.json")
    ]
    for path in candidates:
        if os.path.exists(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, dict) and "en" in data:
                        return data
            except Exception:
                pass
    return {"en": {"title": "Arvor Linux Installer"}}

TEXT = load_translations()

class NetUtils:
    @staticmethod
    def check_connection():
        if SIMULATE: return True
        try:
            socket.create_connection(("8.8.8.8", 53), timeout=3)
            return True
        except OSError:
            return False

    @staticmethod
    def get_svg_data(name, to_white=False):
        url = f"https://raw.githubusercontent.com/feathericons/feather/master/icons/{name}.svg"
        try:
            with urllib.request.urlopen(url, timeout=3) as response:
                data = response.read()
                if to_white:
                    data = data.replace(b'currentColor', b'#ffffff')
                return data
        except:
            return None

class Sys:
    @staticmethod
    def run(cmd, input_text=None, check=True):
        try:
            args = shlex.split(cmd) if isinstance(cmd, str) else cmd
            r = subprocess.run(args, shell=False, check=check, text=True,
                               input=input_text,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            return r.stdout.strip()
        except Exception:
            return None

    @staticmethod
    def run_args(args, input_text=None, check=False):
        try:
            r = subprocess.run(args, shell=False, check=check, text=True,
                               input=input_text,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            return r.stdout.strip()
        except Exception:
            return None

    @staticmethod
    def list_disks():
        if SIMULATE:
            return [
                {"name": "sda", "size": "500G", "model": "NVMe Samsung SSD 980 PRO", "type": "disk"},
                {"name": "sdb", "size": "1000G", "model": "SATA Crucial MX500 SSD", "type": "disk"},
                {"name": "sdc", "size": "2000G", "model": "Seagate Barracuda HDD", "type": "disk"}
            ]
        o = Sys.run("lsblk -d -n -o NAME,SIZE,MODEL,TYPE -J", check=False)
        if o:
            try: return [d for d in json.loads(o)['blockdevices'] if d['type'] == 'disk']
            except: return []
        return []

    @staticmethod
    def get_uuid(dev):
        if SIMULATE and "sda" in dev: return f"UUID-for-{dev}"
        return Sys.run_args(["blkid", "-s", "UUID", "-o", "value", dev])

    @staticmethod
    def list_locales():
        try:
            with open('/usr/share/i18n/SUPPORTED', 'r') as f:
                return sorted([line.split()[0] for line in f if 'UTF-8' in line])
        except:
            return ["en_US.UTF-8", "pt_BR.UTF-8", "es_ES.UTF-8", "fr_FR.UTF-8", "de_DE.UTF-8"]

    @staticmethod
    def list_keymaps():
        out = Sys.run("localectl list-x11-keymap-layouts", check=False)
        if out: return sorted([l for l in out.split('\n') if l.strip()])
        return sorted(["us", "br", "pt", "es", "fr", "de", "it", "gb"])

    @staticmethod
    def list_timezones():
        out = Sys.run("timedatectl list-timezones", check=False)
        if out: return [t for t in out.split('\n') if t.strip()]
        return ["UTC", "America/New_York", "America/Sao_Paulo", "Europe/London", "Europe/Paris", "Europe/Berlin", "Europe/Madrid", "Asia/Tokyo"]

    @staticmethod
    def is_vm():
        r = Sys.run("systemd-detect-virt", check=False)
        return r != "none" if r else False

    @staticmethod
    def is_on_battery():
        p = "/sys/class/power_supply"
        if not os.path.exists(p): return False
        for supply in os.listdir(p):
            if supply.startswith("BAT"):
                status_path = os.path.join(p, supply, "status")
                if os.path.exists(status_path):
                    with open(status_path, 'r') as f:
                        if f.read().strip() == "Discharging": return True
        return False

    @staticmethod
    def detect_system_defaults():
        lang_idx = 0
        detected_locale = "en_US.UTF-8"
        detected_keymap = "us"
        detected_tz = "UTC"

        env_lang = os.environ.get("LANG", "") or os.environ.get("LC_ALL", "")
        if not env_lang and os.path.exists("/etc/default/locale"):
            try:
                with open("/etc/default/locale", "r") as f:
                    for line in f:
                        if line.startswith("LANG="):
                            env_lang = line.split("=", 1)[1].strip().strip('"').strip("'")
                            break
            except Exception:
                pass

        if env_lang:
            detected_locale = env_lang
            low = env_lang.lower()
            if low.startswith("pt"): lang_idx = 1
            elif low.startswith("es"): lang_idx = 2
            elif low.startswith("fr"): lang_idx = 3
            elif low.startswith("de"): lang_idx = 4
            elif low.startswith("gl"): lang_idx = 5
            else: lang_idx = 0

        xkb = Sys.run("localectl status", check=False)
        if xkb:
            for line in xkb.split("\n"):
                if "X11 Layout:" in line:
                    detected_keymap = line.split(":", 1)[1].strip().split(",")[0].strip()
                    break
        if detected_keymap == "us":
            q = Sys.run("setxkbmap -query", check=False)
            if q:
                for line in q.split("\n"):
                    if line.startswith("layout:"):
                        detected_keymap = line.split(":", 1)[1].strip().split(",")[0].strip()
                        break

        tz = Sys.run("timedatectl show -p Timezone --value", check=False)
        if tz and tz.strip():
            detected_tz = tz.strip()
        elif os.path.islink("/etc/localtime"):
            try:
                target = os.readlink("/etc/localtime")
                if "zoneinfo/" in target:
                    detected_tz = target.split("zoneinfo/", 1)[1]
            except Exception:
                pass

        return lang_idx, detected_locale, detected_keymap, detected_tz

class InstallWorker(QThread):
    log_msg = pyqtSignal(str)
    progress = pyqtSignal(int)
    finished = pyqtSignal(bool)

    def __init__(self, conf, locale):
        super().__init__()
        self.conf = conf
        self.sys_locale = locale
        self.mount = "/mnt/arvor"
        self.mapper = "cryptarvor"

    def run_cmd(self, cmd, input_text=None):
        self.log_msg.emit(f"== {cmd}")
        if SIMULATE: return True
        try:
            p = subprocess.Popen(cmd, shell=True, text=True, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            if input_text:
                p.stdin.write(input_text + "\n")
                p.stdin.flush()
            for line in p.stdout:
                self.log_msg.emit(line.strip())
            p.wait()
            return p.returncode == 0
        except Exception as e:
            self.log_msg.emit(f"ERROR: {str(e)}")
            return False

    def simulate_install(self):
        sim_logs = ["==> wipefs -a /dev/sda", "==> parted -s /dev/sda mklabel gpt", "==> mount /dev/arvor_vg/root /mnt/tmp_install", "Installation complete."]
        delay = 10.0 / len(sim_logs)
        for i, msg in enumerate(sim_logs):
            self.log_msg.emit(msg)
            self.progress.emit(int((i + 1) / len(sim_logs) * 100))
            time.sleep(delay)
        self.progress.emit(100)
        self.finished.emit(True)

    def run(self):
        if SIMULATE:
            self.simulate_install()
            return

        self.progress.emit(0)
        d = self.conf["disk"]
        self.log_msg.emit("Starting disk partitioning...")
        self.run_cmd("vgchange -an arvor_vg || true")
        self.run_cmd(f"cryptsetup close {self.mapper} || true")
        self.run_cmd(f"wipefs -a -f {d}")

        self.run_cmd(f"parted -s {d} mklabel gpt")
        self.run_cmd(f"parted -s {d} mkpart ESP fat32 1MiB 513MiB")
        self.run_cmd(f"parted -s {d} set 1 esp on")
        self.run_cmd(f"parted -s {d} mkpart BOOT ext4 513MiB 1537MiB")
        self.run_cmd(f"parted -s {d} mkpart RECOVERY ext4 1537MiB 6657MiB")
        self.run_cmd(f"parted -s {d} mkpart LVM 6657MiB 100%")
        
        self.run_cmd(f"partprobe {d}")
        self.run_cmd("udevadm settle")
        time.sleep(2)
        
        self.progress.emit(15)

        sep = "p" if "nvme" in d else ""
        p1, p2, p3, p4 = f"{d}{sep}1", f"{d}{sep}2", f"{d}{sep}3", f"{d}{sep}4"

        if self.conf["luks"]:
            self.run_cmd(f"cryptsetup luksFormat --type luks2 {p4} -", self.conf["luks_pass"])
            self.run_cmd(f"cryptsetup open {p4} {self.mapper} -", self.conf["luks_pass"])
            lvm_dev = f"/dev/mapper/{self.mapper}"
        else:
            lvm_dev = p4

        self.run_cmd(f"pvcreate -ff -y {lvm_dev}")
        self.run_cmd(f"vgcreate arvor_vg {lvm_dev}")
        
        vg_size_str = Sys.run("vgs --noheadings --units b --nosuffix -o vg_size arvor_vg", check=False)
        try:
            if not vg_size_str:
                raise ValueError("No output returned from vgs command")
            clean_str = vg_size_str.strip().rstrip("B").rstrip("b")
            vg_size_bytes = int(float(clean_str))
            if vg_size_bytes <= 0:
                raise ValueError(f"Invalid VG size: {vg_size_bytes}")
            pool_bytes = int(vg_size_bytes * 0.78)
            pool_mb = pool_bytes // (1024 * 1024)
            if pool_mb <= 0:
                raise ValueError(f"Calculated thin pool size is too small: {pool_mb}MB")
            pool_vsize = f"{pool_mb}M"
        except Exception as e:
            self.log_msg.emit(f"ERROR: Failed to calculate VG thin pool size ({e}). Aborting installation.")
            self.finished.emit(False)
            return

        self.run_cmd(f"lvcreate -L {pool_vsize} -T arvor_vg/arvor_thin_pool")
        self.run_cmd(f"lvcreate -V {pool_vsize} -T arvor_vg/arvor_thin_pool -n root")
        self.run_cmd("lvchange -ay arvor_vg/root")
        self.run_cmd("udevadm settle")

        root_dev = "/dev/mapper/arvor_vg-root"

        self.run_cmd(f"mkfs.vfat -F32 {p1}")
        self.run_cmd(f"mkfs.ext4 -F {p2}")
        self.run_cmd(f"mkfs.ext4 -F -L ARVOR_RECOVERY {p3}")
        self.run_cmd(f"mkfs.xfs -f {root_dev}")
              
        self.run_cmd("udevadm settle")
        time.sleep(2)
        self.progress.emit(25)

        u_root = Sys.get_uuid(root_dev)
        u_boot = Sys.get_uuid(p2)
        u_efi = Sys.get_uuid(p1)
        u_p4 = Sys.get_uuid(p4) if self.conf["luks"] else ""
        f_root = f"UUID={u_root}" if u_root else root_dev
        f_boot = f"UUID={u_boot}" if u_boot else p2
        f_efi = f"UUID={u_efi}" if u_efi else p1
        f_p4 = f"UUID={u_p4}" if u_p4 else p4

        if "UUID=" not in f_root:
            self.log_msg.emit("WARNING: UUID detection failed, using absolute paths in fstab.")

        self.progress.emit(30)

        os.makedirs(self.mount, exist_ok=True)
        self.run_cmd(f"mount {root_dev} {self.mount}")
        os.makedirs(f"{self.mount}/boot", exist_ok=True)
        self.run_cmd(f"mount {p2} {self.mount}/boot")
        os.makedirs(f"{self.mount}/boot/efi", exist_ok=True)
        self.run_cmd(f"mount {p1} {self.mount}/boot/efi")

        if not self.run_cmd(f"debootstrap --arch=amd64 trixie {self.mount} http://deb.debian.org/debian"):
            self.finished.emit(False)
            return
        self.progress.emit(55)

        self.run_cmd(f"wget -O {self.mount}/tmp/nextferret-base.deb https://github.com/NextFerret/arvor/releases/download/basenotiso5/nf-base_3.0.0_amd64.deb")
        for m in ["/dev", "/dev/pts", "/proc", "/sys", "/run"]:
            self.run_cmd(f"mount --bind {m} {self.mount}{m}")
            
        shutil.copy("/etc/resolv.conf", f"{self.mount}/etc/resolv.conf")

        if os.path.exists("/etc/apt/preferences.d/nextferret"):
            os.makedirs(f"{self.mount}/etc/apt/preferences.d", exist_ok=True)
            shutil.copy2("/etc/apt/preferences.d/nextferret", f"{self.mount}/etc/apt/preferences.d/nextferret")

        for file_path in FILES:
            if os.path.exists(file_path):
                dst = f"{self.mount}{file_path}"
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                if os.path.islink(file_path):
                    if os.lexists(dst): os.remove(dst)
                    os.symlink(os.readlink(file_path), dst)
                else:
                    shutil.copy2(file_path, dst)
                    if "bin" in file_path:
                        self.run_cmd(f"chmod +x {dst}")

        if os.path.exists("/etc/motd"):
            try:
                os.makedirs(f"{self.mount}/etc", exist_ok=True)
                with open("/etc/motd", "r") as src, open(f"{self.mount}/etc/motd", "w") as dst:
                    dst.write(src.read())
            except: pass

        if os.path.exists("/usr/lib/os-release"):
            os.makedirs(f"{self.mount}/usr/lib", exist_ok=True)
            shutil.copy2("/usr/lib/os-release", f"{self.mount}/usr/lib/os-release")
        elif os.path.exists("/etc/os-release"):
            os.makedirs(f"{self.mount}/usr/lib", exist_ok=True)
            with open("/etc/os-release", "r") as src, open(f"{self.mount}/usr/lib/os-release", "w") as dst:
                dst.write(src.read())

        if os.path.lexists(f"{self.mount}/etc/os-release"):
            os.remove(f"{self.mount}/etc/os-release")
        os.symlink("../usr/lib/os-release", f"{self.mount}/etc/os-release")

        for osf in ["/etc/lsb-release", "/etc/issue", "/etc/issue.net", "/etc/debian_version", "/usr/share/nextferret/credits.txt"]:
            if os.path.lexists(osf):
                dst = f"{self.mount}{osf}"
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                if os.path.lexists(dst): os.remove(dst)
                if os.path.islink(osf): os.symlink(os.readlink(osf), dst)
                else: shutil.copy2(osf, dst)

        extra_pkgs = self.conf.get("extra_pkgs", "")
        all_pkgs = f"{self.conf['de_pkgs']} {extra_pkgs}".strip()
        de_sh = f"apt-get install -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold {all_pkgs}\n" if all_pkgs else ""

        creds_path = os.path.join(self.mount, "tmp", ".creds")
        try:
            with open(creds_path, "w") as cf:
                cf.write(f"{self.conf['user']}:{self.conf['pass']}\n")
                cf.write(f"root:{self.conf['pass']}\n")
            os.chmod(creds_path, 0o600)
        except Exception as e:
            self.log_msg.emit(f"ERROR writing credentials file: {e}")
            self.finished.emit(False)
            return

        fstab_sh = f"""
cat << EOF > /etc/fstab
{f_root} /               xfs     defaults        0       0
{f_boot} /boot           ext4    defaults        0       2
{f_efi}  /boot/efi       vfat    defaults        0       1
EOF
"""
        if self.conf["luks"]:
            luks_sh = f'echo "{self.mapper} UUID={u_p4} none luks" > /etc/crypttab'
        else:
            luks_sh = ""
            
        swap_mode = self.conf.get("swap_mode", "zram")
        swap_sh = ""
        if swap_mode == "zram":
            swap_sh = """
apt-get install -y --no-install-recommends zram-tools
cat << 'ZRAM_EOF' > /etc/default/zramswap
PERCENT=50
ALGO=zstd
PRIORITY=100
ZRAM_EOF
systemctl enable zramswap || true
"""
        elif swap_mode.startswith("file_"):
            if swap_mode == "file_2g": swap_mb = 2048
            elif swap_mode == "file_4g": swap_mb = 4096
            elif swap_mode == "file_8g": swap_mb = 8192
            elif swap_mode == "file_auto":
                detected_ram_mb = 4096
                try:
                    with open("/proc/meminfo", "r") as f:
                        for line in f:
                            if "MemTotal" in line:
                                detected_ram_mb = int(line.split()[1]) // 1024
                                break
                except Exception: pass
                swap_mb = min(max(2048, detected_ram_mb), 8192)
            else:
                swap_mb = 2048

            swap_sh = f"""
fallocate -l {swap_mb}M /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count={swap_mb}
chmod 600 /swapfile
mkswap /swapfile
echo "/swapfile none swap sw 0 0" >> /etc/fstab
"""


        script = f"""#!/bin/bash
set -e
export DEBIAN_FRONTEND=noninteractive

if [ -e /etc/motd ] || [ -L /etc/motd ]; then
    cp -a /etc/motd /etc/motd.custom_bak
fi
dpkg-divert --package nextferret-core --add --rename --divert /etc/debian_motd /etc/motd || true
if [ -e /etc/motd.custom_bak ]; then
    mv /etc/motd.custom_bak /etc/motd
fi

echo "deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware" > /etc/apt/sources.list
echo "deb http://security.debian.org/debian-security trixie-security main contrib non-free" >> /etc/apt/sources.list

mkdir -p /etc/apt/preferences.d
cat << 'EOF' > /etc/apt/preferences.d/99-block-desktop-base
Package: desktop-base
Pin: release *
Pin-Priority: -2
EOF


for f in /etc/os-release /usr/lib/os-release /etc/lsb-release /etc/issue /etc/issue.net /etc/debian_version; do
    if [ -e "$f" ] || [ -L "$f" ]; then
        cp -a "$f" "$f.custom_bak"
        dpkg-divert --add --package nextferret-core --rename --divert "$f.distrib" "$f" || true
        mv "$f.custom_bak" "$f"
    fi
done

apt-get update

if [ -f /tmp/nextferret-base.deb ]; then
    apt-get install -y --no-install-recommends /tmp/nextferret-base.deb
fi

dpkg-divert --add --package nextferret-core --rename --divert /usr/bin/old-apt /usr/bin/apt
ln -sf /usr/bin/napt /usr/bin/apt

apt-get install -y --no-install-recommends debootstrap python3 linux-image-amd64 sudo network-manager firmware-linux grub-efi-amd64-signed shim-signed locales keyboard-configuration console-setup ca-certificates plymouth plymouth-themes lvm2 xfsprogs grub-common gawk inotify-tools git make efibootmgr curl xz-utils

sed -i "s/^# *{self.sys_locale}/{self.sys_locale}/" /etc/locale.gen || true
locale-gen || true
echo "LANG={self.sys_locale}" > /etc/default/locale

echo 'XKBLAYOUT="{self.conf["keymap"]}"' > /etc/default/keyboard
dpkg-reconfigure -f noninteractive keyboard-configuration

ln -sf /usr/share/zoneinfo/{self.conf["timezone"]} /etc/localtime
systemctl enable NetworkManager

{luks_sh}

userdel -r live 2>/dev/null || true
clean_display_name="{self.conf.get('display_name', self.conf['user'])}"
useradd -m -s /bin/bash -c "$clean_display_name" -G sudo {self.conf['user']}
chpasswd < /tmp/.creds
shred -u /tmp/.creds 2>/dev/null || rm -f /tmp/.creds
echo "{self.conf['hostname']}" > /etc/hostname
echo "127.0.1.1    {self.conf['hostname']}" >> /etc/hosts

{de_sh}
{fstab_sh}
{swap_sh}

if [ -d "/usr/share/plymouth/themes/blockchain" ]; then
    plymouth-set-default-theme blockchain || true
fi

mkdir -p /etc/initramfs-tools/conf.d
echo "RESUME=none" > /etc/initramfs-tools/conf.d/resume
echo "MODULES=most" > /etc/initramfs-tools/conf.d/modules

mkdir -p /etc/initramfs-tools/hooks
cat << 'HOOK' > /etc/initramfs-tools/hooks/lvm2
#!/bin/sh
PREREQS=""
prereqs() {{ echo "$PREREQS"; }}
case "$1" in prereqs) prereqs; exit 0;; esac
. /usr/share/initramfs-tools/hook-functions
copy_exec /sbin/lvm /sbin
copy_exec /sbin/lvchange /sbin
copy_exec /sbin/vgchange /sbin
manual_add_modules dm-thin-pool dm_thin_pool dm-mod
HOOK
chmod +x /etc/initramfs-tools/hooks/lvm2

mkdir -p /etc/initramfs-tools/scripts/local-top
cat << 'SCRIPT' > /etc/initramfs-tools/scripts/local-top/activate_lvm
#!/bin/sh
PREREQS="lvm2"
prereqs() {{ echo "$PREREQS"; }}
case "$1" in prereqs) prereqs; exit 0;; esac
vgchange -ay arvor_vg || true
SCRIPT
chmod +x /etc/initramfs-tools/scripts/local-top/activate_lvm

chmod +x /etc/initramfs-tools/hooks/arvor_lvm_rollback || true
chmod +x /etc/initramfs-tools/scripts/local-top/arvor_lvm_snapshot || true
chmod +x /usr/bin/arvor-boot-success || true
chmod +x /usr/bin/arvorctl || true
chmod +x /usr/bin/arvor-guard || true
chmod +x /etc/grub.d/10_arvor_snapshots || true
systemctl enable arvor-boot-success.service || true
systemctl enable arvor-guard.timer || true

touch /etc/default/grub

sed -i 's|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX="rd.lvm.lv=arvor_vg/root"|' /etc/default/grub || true
grep -q "rd.lvm.lv" /etc/default/grub || echo 'GRUB_CMDLINE_LINUX="rd.lvm.lv=arvor_vg/root"' >> /etc/default/grub

cat << 'EOF' > /etc/grub.d/11_arvor_recovery
#!/bin/sh
exec tail -n +3 $0
menuentry "Arvor Linux Recovery Mode" --class arvor --class recovery {{
    search --no-floppy --set=root --label ARVOR_RECOVERY
    linux /boot/vmlinuz root=LABEL=ARVOR_RECOVERY rw quiet splash
    initrd /boot/initrd.img
}}
EOF
chmod +x /etc/grub.d/11_arvor_recovery || true

update-initramfs -c -k all || update-initramfs -u
grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=arvor-linux --removable || true

mkdir -p /boot/efi/EFI/arvor-recovery
if [ -f /boot/efi/EFI/arvor-linux/grubx64.efi ]; then
    cp -a /boot/efi/EFI/arvor-linux/grubx64.efi /boot/efi/EFI/arvor-recovery/grubx64.efi
fi
cat << 'EOF' > /boot/efi/EFI/arvor-recovery/grub.cfg
search --no-floppy --set=root --label ARVOR_RECOVERY
configfile /boot/grub/grub.cfg
EOF

EXISTING_REC=$(efibootmgr | grep "Arvor Linux Recovery" | awk '{{print $1}}' | tr -d 'Boot*' | tr -d ':' || true)
if [ -n "$EXISTING_REC" ]; then
    efibootmgr -b "$EXISTING_REC" -B >/dev/null 2>&1 || true
fi

efibootmgr -c -d {self.conf["disk"]} -p 1 -L "Arvor Linux" -l "\\EFI\\arvor-linux\\grubx64.efi" || true
efibootmgr -c -d {self.conf["disk"]} -p 1 -L "Arvor Linux Recovery" -l "\\EFI\\arvor-recovery\\grubx64.efi" || true
update-grub

napt sync
apt-get clean
rm /s.sh
exit 0
"""
        chroot_script_path = os.path.join(self.mount, "s.sh")
        with open(chroot_script_path, "w") as f: f.write(script)
        self.run_cmd(f"chmod +x {chroot_script_path}")
        self.run_cmd(f"chroot {self.mount} /s.sh")
        self.progress.emit(90)

        # Setup and populate dedicated Recovery partition (p3)
        self.log_msg.emit("Configuring dedicated Arvor Recovery partition (debootstrap)...")
        rec_mnt = "/mnt/recovery_staging"
        os.makedirs(rec_mnt, exist_ok=True)
        self.run_cmd(f"mount {p3} {rec_mnt}")

        # 1. Debootstrap standalone minimal base for recovery
        deb_rec_cmd = (
            f"debootstrap --variant=minbase --arch=amd64 "
            f"--include=python3,python3-pyqt6,lvm2,xfsprogs,e2fsprogs,parted,util-linux,pciutils,iproute2,systemd-sysv,bash,coreutils,kmod,linux-image-amd64,sudo,rsync,grub-efi-amd64-signed "
            f"trixie {rec_mnt} http://deb.debian.org/debian"
        )
        if not self.run_cmd(deb_rec_cmd):
            self.log_msg.emit("Recovery debootstrap network failed, falling back to base sync from target...")
            self.run_cmd(f"rsync -aHAX --exclude=/proc/* --exclude=/sys/* --exclude=/dev/* --exclude=/run/* --exclude=/tmp/* --exclude=/home/* --exclude=/root/* --exclude=/boot/efi/* {self.mount}/ {rec_mnt}/")

        # 2. Configure credentials in recovery: root (root:root) and default user arvor (arvor:arvor with sudo)
        self.run_cmd(f'chroot {rec_mnt} /bin/sh -c "echo \"root:root\" | chpasswd"')
        self.run_cmd(f'chroot {rec_mnt} /bin/sh -c "id -u arvor >/dev/null 2>&1 || useradd -m -s /bin/bash -G sudo arvor && echo \"arvor:arvor\" | chpasswd"')

        # 3. Install Arvor Recovery binaries and application
        rec_src_candidates = [
            "/usr/lib/arvor-recovery",
            "/home/yrozxm/Projectos/arvor-recovery-main",
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../arvor-recovery-main"),
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "../lib/arvor-recovery")
        ]
        rec_src = None
        for cand in rec_src_candidates:
            if os.path.isdir(os.path.join(cand, "core")):
                rec_src = cand
                break

        if rec_src:
            os.makedirs(f"{rec_mnt}/usr/lib/arvor-recovery", exist_ok=True)
            for sub in ["core", "ui", "assets"]:
                src_sub = os.path.join(rec_src, sub)
                if os.path.exists(src_sub):
                    self.run_cmd(f"cp -a {src_sub} {rec_mnt}/usr/lib/arvor-recovery/")
            bin_src = os.path.join(rec_src, "bin", "arvor-recovery")
            if os.path.exists(bin_src):
                self.run_cmd(f"cp {bin_src} {rec_mnt}/usr/bin/arvor-recovery")
                self.run_cmd(f"chmod +x {rec_mnt}/usr/bin/arvor-recovery")
        elif os.path.exists("/usr/bin/arvor-recovery"):
            self.run_cmd(f"cp /usr/bin/arvor-recovery {rec_mnt}/usr/bin/arvor-recovery")
            self.run_cmd(f"chmod +x {rec_mnt}/usr/bin/arvor-recovery")

        # 4. Configure autologin on TTY1 to launch arvor-recovery
        override_dir = f"{rec_mnt}/etc/systemd/system/getty@tty1.service.d"
        os.makedirs(override_dir, exist_ok=True)
        try:
            with open(f"{override_dir}/override.conf", "w") as f:
                f.write("""[Service]
ExecStart=
ExecStart=-/usr/bin/arvor-recovery
StandardInput=tty
StandardOutput=tty
Restart=always
RestartSec=1
""")
        except Exception as e:
            self.log_msg.emit(f"WARN: Failed writing tty1 override: {e}")

        # 5. Recovery fstab
        try:
            with open(f"{rec_mnt}/etc/fstab", "w") as f:
                f.write("LABEL=ARVOR_RECOVERY  /  ext4  defaults  0  1\n")
        except Exception as e:
            self.log_msg.emit(f"WARN: Failed writing recovery fstab: {e}")

        # 6. Ensure kernel and initrd in {rec_mnt}/boot
        os.makedirs(f"{rec_mnt}/boot/grub", exist_ok=True)
        if os.path.exists(f"{rec_mnt}/boot"):
            b_files = os.listdir(f"{rec_mnt}/boot")
            vms = sorted([f for f in b_files if f.startswith("vmlinuz-")])
            inis = sorted([f for f in b_files if f.startswith("initrd.img-")])
            if vms and not os.path.exists(f"{rec_mnt}/boot/vmlinuz"):
                try: os.symlink(vms[-1], f"{rec_mnt}/boot/vmlinuz")
                except: self.run_cmd(f"cp {rec_mnt}/boot/{vms[-1]} {rec_mnt}/boot/vmlinuz")
            if inis and not os.path.exists(f"{rec_mnt}/boot/initrd.img"):
                try: os.symlink(inis[-1], f"{rec_mnt}/boot/initrd.img")
                except: self.run_cmd(f"cp {rec_mnt}/boot/{inis[-1]} {rec_mnt}/boot/initrd.img")

        # If kernel missing on recovery partition, copy from main system boot
        if not os.path.exists(f"{rec_mnt}/boot/vmlinuz") and os.path.exists(f"{self.mount}/boot"):
            b_files = os.listdir(f"{self.mount}/boot")
            vms = sorted([f for f in b_files if f.startswith("vmlinuz-")])
            inis = sorted([f for f in b_files if f.startswith("initrd.img-")])
            if vms: self.run_cmd(f"cp {self.mount}/boot/{vms[-1]} {rec_mnt}/boot/vmlinuz")
            if inis: self.run_cmd(f"cp {self.mount}/boot/{inis[-1]} {rec_mnt}/boot/initrd.img")

        # 7. Write recovery GRUB configuration
        grub_rec_content = """set default=0
set timeout=5

insmod part_gpt
insmod part_msdos
insmod ext2
insmod fat
insmod font
insmod gfxterm

search --no-floppy --set=root --label ARVOR_RECOVERY

menuentry "Arvor Linux Recovery Mode (Safe Environment)" --class arvor --class gnu-linux --class os {
    linux /boot/vmlinuz root=LABEL=ARVOR_RECOVERY rw quiet splash
    initrd /boot/initrd.img
}

menuentry "Arvor Linux Recovery Mode (Debug Verbose Console)" --class arvor --class gnu-linux --class os {
    linux /boot/vmlinuz root=LABEL=ARVOR_RECOVERY rw debug verbose systemd.debug_shell=1
    initrd /boot/initrd.img
}

menuentry "Return to Main OS Bootloader" {
    search --no-floppy --set=root --file /EFI/arvor-linux/grubx64.efi
    chainloader /EFI/arvor-linux/grubx64.efi
}

menuentry "UEFI Firmware Settings" {
    fwsetup
}

menuentry "Reboot System" {
    reboot
}
"""
        try:
            with open(f"{rec_mnt}/boot/grub/grub.cfg", "w") as f:
                f.write(grub_rec_content)
        except Exception as e:
            self.log_msg.emit(f"WARN: Failed to write recovery grub.cfg: {e}")

        self.run_cmd(f"umount {rec_mnt}")
        self.progress.emit(95)

        for m in ["/run", "/sys", "/proc", "/dev/pts", "/dev"]: 
            self.run_cmd(f"umount -l {self.mount}{m}")
            
        try: self.run_cmd(f"umount -R {self.mount}")
        except: self.run_cmd(f"umount -l {self.mount}")

        self.run_cmd("vgchange -an arvor_vg || true")
        if self.conf["luks"]: self.run_cmd(f"cryptsetup close {self.mapper}")

        self.progress.emit(100)
        self.finished.emit(True)


class InstallerGUI(QMainWindow):
    def __init__(self):
        super().__init__()
        self.swap_modes = [
            ("zram", "swap_zram"),
            ("file_2g", "swap_file_2g"),
            ("file_4g", "swap_file_4g"),
            ("file_8g", "swap_file_8g"),
            ("file_auto", "swap_auto"),
            ("none", "swap_none")
        ]

        self.list_of_locales = Sys.list_locales()
        self.list_of_keymaps = Sys.list_keymaps()
        self.list_of_timezones = Sys.list_timezones()

        auto_lang_idx, auto_locale, auto_keymap, auto_tz = Sys.detect_system_defaults()
        self.initial_lang_idx = auto_lang_idx

        self.lang_map = {
            0: ("en", "en_US.UTF-8", "us", "UTC"),
            1: ("pt", "pt_BR.UTF-8", "br", "America/Sao_Paulo"),
            2: ("es", "es_ES.UTF-8", "es", "Europe/Madrid"),
            3: ("fr", "fr_FR.UTF-8", "fr", "Europe/Paris"),
            4: ("de", "de_DE.UTF-8", "de", "Europe/Berlin"),
            5: ("gl", "gl_ES.UTF-8", "gl", "Europe/Madrid")
        }

        lang, default_loc, default_keymap, default_tz = self.lang_map.get(auto_lang_idx, self.lang_map[0])
        self.ui_lang = lang
        self.sys_locale = auto_locale if auto_locale in self.list_of_locales else default_loc

        self.conf = {
            "hostname": "arvor", "disk": None, "display_name": "", "user": "", "pass": "",
            "luks": False, "luks_pass": "",
            "keymap": auto_keymap if auto_keymap in self.list_of_keymaps else default_keymap,
            "timezone": auto_tz if auto_tz in self.list_of_timezones else default_tz,
            "de_name": "None", "de_pkgs": "", "extra_pkgs": "",
            "swap_mode": "zram"
        }
        self.user_manually_edited = False
        self.desktops = [
            ("None (CLI)", ""), ("XFCE", "xfce4 xfce4-goodies lightdm"), ("GNOME", "gnome-core gdm3"),
            ("KDE Plasma", "kde-standard sddm"), ("Cinnamon", "cinnamon-core lightdm"),
            ("MATE", "mate-desktop-environment lightdm"), ("LXQt", "lxqt-core sddm")
        ]
        self.icon_cache = {}
        self.sidebar_icon_cache = {}

        self.steps = ["step_welcome", "step_location", "step_keyboard", "step_desktop",
                      "step_zram", "step_partitions", "step_users", "step_summary", "step_install", "step_finish"]
        self.step_keys = ["welcome", "location", "keyboard", "software", "zram", "disk", "users", "summary", "install", "finish"]

        self.preload_icons()
        self.init_ui()

    def t(self, key):
        return TEXT[self.ui_lang].get(key, key)

    def preload_icons(self):
        sidebar_icons = {"welcome": "smile", "location": "map-pin", "keyboard": "grid", "software": "package", "zram": "zap", "disk": "hard-drive", "users": "users", "summary": "file-text", "install": "download-cloud", "finish": "check-circle"}
        for k, v in sidebar_icons.items():
            data = NetUtils.get_svg_data(v, to_white=True)
            if data:
                pm = QPixmap()
                pm.loadFromData(data)
                self.sidebar_icon_cache[k] = QIcon(pm)

        nav_icons = {"next": "arrow-right", "back": "arrow-left", "install_btn": "download", "check_btn": "check"}
        for k, v in nav_icons.items():
            data = NetUtils.get_svg_data(v, to_white=False)
            if data:
                pm = QPixmap()
                pm.loadFromData(data)
                self.icon_cache[k] = QIcon(pm)

    def get_sidebar_icon(self, name): return self.sidebar_icon_cache.get(name, QIcon())
    def get_nav_icon(self, name): return self.icon_cache.get(name, QIcon())

    def init_ui(self):
        self.setWindowTitle(self.t("title"))
        self.setMinimumSize(1150, 750)

        main_widget = QWidget()
        main_layout = QHBoxLayout()
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(0)

        sidebar_panel = QWidget()
        sidebar_panel.setFixedWidth(280)
        sidebar_panel.setStyleSheet("background:#162033;")
        sidebar_layout = QVBoxLayout()
        sidebar_layout.setContentsMargins(0, 0, 0, 0)
        sidebar_layout.setSpacing(0)

        logo_header = QWidget()
        logo_header.setFixedHeight(145)
        logo_header.setStyleSheet("background:#162033;")
        logo_layout = QVBoxLayout(logo_header)
        logo_layout.setContentsMargins(0, 12, 0, 12)
        logo_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)

        self.sidebar_logo = QLabel(logo_header)
        self.sidebar_logo.setFixedSize(112, 112)
        self.sidebar_logo.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.sidebar_logo.setStyleSheet("background:transparent; border:none; padding:0;")

        logo_loaded = False
        for sys_path in [
            "/usr/share/icons/hicolor/4000x4000/distributor-logo.png",
            "/usr/share/icons/hicolor/scalable/apps/distributor-logo.svg",
            "/usr/share/pixmaps/arvor.png"
        ]:
            if os.path.exists(sys_path):
                pm = QPixmap(sys_path)
                if not pm.isNull():
                    self.sidebar_logo.setPixmap(
                        pm.scaled(100, 100, Qt.AspectRatioMode.KeepAspectRatio,
                                  Qt.TransformationMode.SmoothTransformation)
                    )
                    logo_loaded = True
                    break

        if not logo_loaded:
            try:
                renderer = QSvgRenderer(QByteArray(ARVOR_LOGO_SVG.encode('utf-8')))
                pm = QPixmap(100, 100)
                pm.fill(Qt.GlobalColor.transparent)
                painter = QPainter(pm)
                renderer.render(painter)
                painter.end()
                if not pm.isNull():
                    self.sidebar_logo.setPixmap(pm)
            except Exception:
                self.sidebar_logo.setText("")

        logo_layout.addWidget(self.sidebar_logo, 0, Qt.AlignmentFlag.AlignCenter)
        sidebar_layout.addWidget(logo_header, 0)

        self.sidebar = QListWidget()
        self.sidebar.setStyleSheet("QListWidget{background:#162033;border:none;padding:0;} QListWidget::item{padding:15px 22px;color:#8e9db4;border-left:3px solid transparent;} QListWidget::item:hover{background:#202c42;color:#eef4ff;} QListWidget::item:selected{background:#27344d;color:#fff;border-left:3px solid #4a78ff;}")
        self.sidebar.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.sidebar.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)

        for i, s in enumerate(self.steps):
            item = QListWidgetItem(self.get_sidebar_icon(self.step_keys[i]), self.t(s))
            self.sidebar.addItem(item)

        sidebar_layout.addWidget(self.sidebar, 1)
        sidebar_panel.setLayout(sidebar_layout)
        main_layout.addWidget(sidebar_panel)

        right_panel = QWidget()
        right_layout = QVBoxLayout()
        right_layout.setContentsMargins(50, 50, 50, 40)

        self.stack = QStackedWidget()
        self.build_pages()
        right_layout.addWidget(self.stack)

        self.nav_container = self.create_nav_bar()
        right_layout.addSpacing(25)
        right_layout.addWidget(self.nav_container)

        right_panel.setLayout(right_layout)
        main_layout.addWidget(right_panel)
        main_widget.setLayout(main_layout)
        self.setCentralWidget(main_widget)

        self.update_sidebar()
        self.btn_back.setEnabled(False)
        self.change_language(self.initial_lang_idx)

    def build_pages(self):
        self.stack.addWidget(self.create_welcome_page())
        self.stack.addWidget(self.create_location_page())
        self.stack.addWidget(self.create_keyboard_page())
        self.stack.addWidget(self.create_desktop_page())
        self.stack.addWidget(self.create_zram_page())
        self.stack.addWidget(self.create_partitions_page())
        self.stack.addWidget(self.create_users_page())
        self.stack.addWidget(self.create_summary_page())
        self.stack.addWidget(self.create_install_page())
        self.stack.addWidget(self.create_finish_page())

    def create_nav_bar(self):
        nav_frame = QFrame()
        nav_frame.setProperty("card", "true")
        shadow = QGraphicsDropShadowEffect()
        shadow.setBlurRadius(30)
        shadow.setColor(QColor(0, 0, 0, 20))
        shadow.setOffset(0, 6)
        nav_frame.setGraphicsEffect(shadow)
        nav_layout = QHBoxLayout()
        nav_layout.setContentsMargins(25, 20, 25, 20)
        self.btn_back = QPushButton(self.get_nav_icon("back"), self.t("back"))
        self.btn_next = QPushButton(self.get_nav_icon("next"), self.t("next"))
        self.btn_next.setLayoutDirection(Qt.LayoutDirection.RightToLeft)
        self.btn_next.setProperty("primary", "true")
        self.btn_next.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_back.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_back.clicked.connect(self.go_back)
        self.btn_next.clicked.connect(self.go_next)
        nav_layout.addStretch()
        nav_layout.addWidget(self.btn_back)
        nav_layout.addSpacing(15)
        nav_layout.addWidget(self.btn_next)
        nav_frame.setLayout(nav_layout)
        return nav_frame

    def update_sidebar(self):
        idx = self.stack.currentIndex()
        for i in range(self.sidebar.count()):
            self.sidebar.item(i).setSelected(i == idx)

    def create_title(self, text_key, sub_key=None):
        container = QWidget()
        l = QVBoxLayout()
        l.setContentsMargins(0,0,0,25)
        lbl = QLabel(self.t(text_key))
        lbl.setProperty("text_key", text_key)
        lbl.setProperty("heading", "true")
        l.addWidget(lbl)
        if sub_key:
            sub = QLabel(self.t(sub_key))
            sub.setProperty("text_key", sub_key)
            sub.setProperty("subheading", "true")
            l.addWidget(sub)
        container.setLayout(l)
        return container

    def _create_card(self):
        card = QFrame()
        card.setProperty("card", "true")
        shadow = QGraphicsDropShadowEffect()
        shadow.setBlurRadius(20)
        shadow.setColor(QColor(0, 0, 0, 12))
        shadow.setOffset(0, 4)
        card.setGraphicsEffect(shadow)
        cl = QVBoxLayout()
        cl.setContentsMargins(25, 25, 25, 25)
        card.setLayout(cl)
        return card, cl

    def _create_label(self, text_key, style="font-weight: 600; color: #334155; margin-bottom: 5px; margin-top: 10px;"):
        lbl = QLabel(self.t(text_key))
        lbl.setStyleSheet(style)
        return lbl

    def _make_combo(self):
        cb = QComboBox()
        cb.setMaxVisibleItems(12)
        view = QListView()
        view.setSpacing(2)
        view.setStyleSheet("background:#ffffff; border:none; outline:none; padding:4px;")
        cb.setView(view)
        cb.setStyleSheet("QComboBox QAbstractItemView { border: none; }")

        original_show = cb.showPopup
        def patched_show():
            original_show()
            popup = cb.view().window()
            popup.setWindowFlags(Qt.WindowType.Popup | Qt.WindowType.FramelessWindowHint)
            popup.setStyleSheet("background:#ffffff; border:1px solid #d9e1eb; border-radius:10px;")
            popup.show()
        cb.showPopup = patched_show
        return cb

    def _create_alert(self, msg_key, alert_type):
        f = QFrame()
        f.setProperty("alert", alert_type)
        hl = QHBoxLayout()
        lbl = QLabel(self.t(msg_key))
        lbl.setProperty("alert-text", alert_type)
        hl.addWidget(lbl)
        hl.addStretch()
        f.setLayout(hl)
        return f

    def create_welcome_page(self):
        w = QWidget()
        l = QVBoxLayout()
        l.addWidget(self.create_title("welcome_msg", "welcome_sub"))

        if Sys.is_vm() and not SIMULATE:
            l.addWidget(self._create_alert("warn_vm", "warning"))
            l.addSpacing(15)

        if Sys.is_on_battery() and not SIMULATE:
            l.addWidget(self._create_alert("warn_power", "danger"))

        card, cl = self._create_card()
        self.lbl_lang = self._create_label("locale")
        self.c_lang = self._make_combo()
        self.c_lang.addItems(["English", "Português (Brasil)", "Español", "Français", "Deutsch", "Galego"])
        self.c_lang.currentIndexChanged.connect(self.change_language)

        cl.addWidget(self.lbl_lang)
        cl.addWidget(self.c_lang)
        self.c_lang.setCurrentIndex(self.initial_lang_idx)
        l.addWidget(card)
        l.addStretch()
        w.setLayout(l)
        return w

    def change_language(self, index):
        if index in self.lang_map:
            lang, loc, keymap, tz = self.lang_map[index]
            self.ui_lang = lang
            self.sys_locale = loc
            self.conf["keymap"] = keymap
            self.conf["timezone"] = tz

        if hasattr(self, 'c_locale'): self.c_locale.setCurrentText(self.sys_locale)
        if hasattr(self, 'c_key'): self.c_key.setCurrentText(self.conf["keymap"])
        if hasattr(self, 'i_tz'): self.i_tz.setCurrentText(self.conf["timezone"])

        self.setWindowTitle(self.t("title"))
        self.update_sidebar()

        for i, s in enumerate(self.steps):
            self.sidebar.item(i).setText(self.t(s))

        if hasattr(self, 'lbl_lang'): self.lbl_lang.setText(self.t("locale"))
        if hasattr(self, 'lbl_loc'): self.lbl_loc.setText(self.t("locale"))
        if hasattr(self, 'lbl_tz'): self.lbl_tz.setText(self.t("tz"))
        if hasattr(self, 'lbl_key'): self.lbl_key.setText(self.t("keymap"))
        if hasattr(self, 'lbl_key_test'): self.lbl_key_test.setText(self.t("lbl_key_test"))
        if hasattr(self, 'i_key_test'): self.i_key_test.setPlaceholderText(self.t("test_keymap"))
        if hasattr(self, 'lbl_de'): self.lbl_de.setText(self.t("de"))
        if hasattr(self, 'lbl_disk'): self.lbl_disk.setText(self.t("disk"))
        if hasattr(self, 'chk_luks'): self.chk_luks.setText(self.t("luks"))
        if hasattr(self, 'lbl_luks_p'): self.lbl_luks_p.setText(self.t("luks_p"))
        if hasattr(self, 'lbl_host'): self.lbl_host.setText(self.t("host"))
        if hasattr(self, 'lbl_display_name'): self.lbl_display_name.setText(self.t("display_name"))
        if hasattr(self, 'lbl_user'): self.lbl_user.setText(self.t("user_name"))
        if hasattr(self, 'lbl_pass'): self.lbl_pass.setText(self.t("pass"))
        if hasattr(self, 'lbl_pass_c'): self.lbl_pass_c.setText(self.t("pass_c"))
        if hasattr(self, 'lbl_swap'): self.lbl_swap.setText(self.t("lbl_swap"))
        if hasattr(self, 'c_swap'): self.update_swap_options()
        if hasattr(self, 'update_swap_desc'): self.update_swap_desc()
        if hasattr(self, 'update_de_desc'): self.update_de_desc()
        if hasattr(self, 'lbl_apps_header'): self.lbl_apps_header.setText(self.t("apps_header"))
        if hasattr(self, 'lbl_drivers_header'): self.lbl_drivers_header.setText(self.t("drivers_header"))
        if hasattr(self, 'chk_firefox'): self.chk_firefox.setText(self.t("app_firefox"))
        if hasattr(self, 'chk_chromium'): self.chk_chromium.setText(self.t("app_chromium"))
        if hasattr(self, 'chk_office'): self.chk_office.setText(self.t("app_office"))
        if hasattr(self, 'chk_vlc'): self.chk_vlc.setText(self.t("app_vlc"))
        if hasattr(self, 'chk_nvidia'): self.chk_nvidia.setText(self.t("drv_nvidia"))
        if hasattr(self, 'chk_firmware'): self.chk_firmware.setText(self.t("drv_firmware"))

        if hasattr(self, 'btn_back'): self.btn_back.setText(self.t("back"))
        if hasattr(self, 'btn_next'):
            idx = self.stack.currentIndex()
            if idx == 7: self.btn_next.setText(self.t("install"))
            elif idx == 9: self.btn_next.setText(self.t("quit"))
            else: self.btn_next.setText(self.t("next"))

        for i in range(self.stack.count()):
            page = self.stack.widget(i)
            target = page.widget() if isinstance(page, QScrollArea) else page
            if target:
                for child in target.findChildren(QLabel):
                    if child.property("text_key"):
                        child.setText(self.t(child.property("text_key")))

    def create_location_page(self):
        w = QWidget()
